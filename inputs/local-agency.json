{
  "browser": { "mode": "launch", "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe", "headless": true },
  "start_url": { "url": "http://127.0.0.1:4173/#agency" },
  "environment": { "viewport": { "width": 1440, "height": 1000, "device_scale_factor": 1 }, "locale": "zh-CN", "timezone": "Asia/Shanghai" },
  "actions": [
    { "step_id": "agency-invite-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "#switch-agency" }, "state": "visible", "timeout_ms": 10000 },
    { "step_id": "switch-agency-role", "action": "click", "locator": { "kind": "css", "selector": "#switch-agency" }, "timeout_ms": 10000 },
    { "step_id": "metrics-ready", "action": "wait_for", "locator": { "kind": "css", "selector": ".metric-card:first-of-type" }, "state": "visible", "timeout_ms": 10000 }
  ],
  "capture": { "at_end": ["dom", "accessibility", "screenshot", "url"], "events": ["network", "console", "page-errors"], "network": { "response_body": true } }
}
