{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://www.ctrip.com/" },
  "environment": {
    "viewport": { "width": 1440, "height": 1000, "device_scale_factor": 1 },
    "locale": "zh-CN",
    "timezone": "Asia/Shanghai",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    { "step_id": "homepage-settle", "action": "wait_for_timeout", "duration_ms": 10000 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "screenshot", "url"],
    "events": ["network", "console", "page-errors", "frames", "workers", "popups", "websockets"],
    "network": { "request_body": true, "response_body": true, "header_values": true }
  }
}
